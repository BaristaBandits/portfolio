---
---
<div class="row">
  <div class="col-sm-12">
    <div class="title">
      <a href="{{ entry.url | escape }}">{{ entry.title }}</a>
    </div>
    <div class="author">
      {% for author in entry.author_array -%}
        {%- if author.last contains 'Narashiman' -%}
          <em>
            {{- author.first }}
            {{ author.last -}}
          </em>
        {%- else -%}
          {{- author.first }}
          {{ author.last -}}
        {%- endif -%}
        {%- unless forloop.last %}, {% endunless -%}
      {%- endfor %}
    </div>
    {% if entry.booktitle %}
      <div class="periodical">
        <em>{{ entry.booktitle }}</em>
      </div>
    {% endif %}
    {% if entry.abstract %}
      <details class="publication-abstract">
        <summary>Abstract</summary>
        <p>{{ entry.abstract }}</p>
      </details>
    {% endif %}
  </div>
</div>
