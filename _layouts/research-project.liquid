---
layout: default
---
{% assign story = site.data.project_stories[page.story] %}
<link rel="stylesheet" href="{{ '/assets/css/folio.css' | relative_url }}">
<link rel="stylesheet" href="{{ '/assets/css/research.css' | relative_url }}">
<article class="folio research-story">
  <a class="research-back" href="{{ '/projects/' | relative_url }}">← All projects</a>
  <header class="research-header">
    <p class="folio-eyebrow">
      {{ page.research_area | escape -}}
      {%- if page.research_year %} / {{ page.research_year }}{% endif %}
    </p>
    <h1>{{ page.title | escape }}</h1>
    <p class="research-question">{{ story.question | escape }}</p>
    <p class="research-context">{{ story.context | escape }}</p>
    <div class="project-card-links">
      {% if story.paper -%}
        <a class="research-primary" href="{{ story.paper | escape }}">Read the paper ↗</a>
      {%- endif %}
      {% if story.pdf -%}
        <a class="folio-link" href="{{ story.pdf | escape }}">Paper PDF ↗</a>
      {%- endif %}
      {% if story.code -%}
        <a class="folio-link" href="{{ story.code | escape }}">Code ↗</a>
      {%- endif %}
      {% if story.demo_url -%}
        <a class="folio-link" href="{{ story.demo_url | escape }}">Listen to examples ↗</a>
      {%- endif %}
    </div>
  </header>
  <section class="research-takeaway" aria-label="The idea in plain language">
    <p>{{ story.plain | escape }}</p>
  </section>
  <section class="research-method">
    <p class="folio-eyebrow">Inside the method</p>
    <h2>Follow the idea.</h2>
    <p class="research-step-hint" hidden data-step-hint>Choose a step to see how it works.</p>
    <div data-stepper>
      <div class="research-step-controls" hidden data-step-controls role="group" aria-label="Method steps">
        {% for step in story.steps -%}
          <button type="button" data-step-button="{{ forloop.index0 }}" aria-pressed="true" aria-controls="method-{{ forloop.index }}">
            0{{ forloop.index }} / {{ step.title | escape }}
          </button>
        {%- endfor %}
        <button type="button" data-step-all aria-pressed="true">Show all</button>
      </div>
      {% for step in story.steps %}
        <div class="research-step" id="method-{{ forloop.index }}" data-step-panel>
          <h3>
            <span>0{{ forloop.index }}</span> {{ step.title | escape }}
          </h3>
          <p>{{ step.text | escape }}</p>
        </div>
      {% endfor %}
    </div>
  </section>
  {% if story.demo %}{% include research-demo.liquid demo=story.demo %}{% endif %}
  {% if story.figure %}
    {% assign figure_path = story.figure | prepend: '/assets/img/research/' %}
    <figure class="research-figure">
      <a href="{{ figure_path | relative_url }}" aria-label="View full-size figure: {{ story.caption | escape }}"
        ><img src="{{ figure_path | relative_url }}" alt="{{ story.caption | escape }}" loading="lazy"
      ></a>
      <figcaption>
        {{ story.caption | escape }}
        <a href="{{ story.source | escape }}">Source figure ↗</a> · Select image for full size.
      </figcaption>
    </figure>
  {% endif %}
  {% if story.extra_figure %}
    <details class="research-figure">
      <summary>See the pattern across many contexts</summary>
      <figure>
        <img
          src="{{ story.extra_figure.file | prepend: '/assets/img/research/' | relative_url }}"
          alt="{{ story.extra_figure.caption | escape }}"
          loading="lazy"
        >
        <figcaption>
          {{ story.extra_figure.caption | escape }}
          <a href="{{ story.extra_figure.source | escape }}">Source figure ↗</a>
        </figcaption>
      </figure>
    </details>
  {% endif %}
  {% if story.materials %}
    <section class="research-materials">
      <h2>Supporting materials</h2>
      <div class="project-card-links">
        {% for material in story.materials -%}
          <a class="folio-link" href="{{ material.url | relative_url }}">{{ material.title | escape }} ↗</a>
        {%- endfor %}
      </div>
    </section>
  {% endif %}
  <section class="research-results">
    <h2>What we found</h2>
    <p>{{ story.finding | escape }}</p>
    <details>
      <summary>Scope & limitations</summary>
      <p>{{ story.limit | escape }}</p>
    </details>
  </section>
  {% if story.paper %}
    <section class="research-citation">
      <p class="folio-eyebrow">Read the full work</p>
      <h2>
        <a href="{{ story.paper | escape }}">{{ story.paper_title | escape }}</a>
      </h2>
      <p>{{ story.authors | escape }}</p>
      <p>{{ story.venue | escape }}</p>
    </section>
  {% elsif story.related_paper %}
    <section class="research-citation">
      <h2>Related reading</h2>
      <a href="{{ story.related_paper | escape }}">{{ story.related_title | escape }} ↗</a>
    </section>
  {% endif %}
  <a class="folio-link" href="{{ '/projects/' | relative_url }}">Back to the workbench ↗</a>
</article>
<script src="{{ '/assets/js/research.js' | relative_url }}" defer></script>
