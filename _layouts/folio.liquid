---
layout: default
---
<link rel="stylesheet" href="{{ '/assets/css/folio.css' | relative_url }}">
<div class="folio">
  <header class="folio-hero">
    <p class="folio-eyebrow">{{ page.eyebrow | escape }}</p>
    <h1>{{ page.headline | default: page.title | escape }}</h1>
    <p class="folio-intro">{{ page.description | escape }}</p>
    {% if page.scholar_link %}
      <a class="folio-link" href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}&amp;sortby=pubdate"
        >View Google Scholar <span aria-hidden="true">↗</span></a
      >
    {% endif %}
  </header>
  {{ content }}
  <footer class="folio-endnote">
    <span>{{ page.endnote | default: 'Curiosity, in progress.' | escape }}</span>
    <a href="{{ '/' | relative_url }}">Back to the introduction <span aria-hidden="true">↗</span></a>
  </footer>
</div>
<script src="{{ '/assets/js/folio.js' | relative_url }}" defer></script>
