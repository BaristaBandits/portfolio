@inproceedings{narashiman-etal-2026-trajectories,
    title = "From Trajectories to Workflows: Online Procedural Memory Abstraction for Language Agents",
    author = "Narashiman, Swathi Shree  and
      Jindal, Ishan  and
      Chandran, Mahesh",
    editor = "Kamalloo, Ehsan  and
      Gontier, Nicolas  and
      Rozanov, Nikolai  and
      Hashemzadeh, Maryam  and
      Arora, Akhil",
    booktitle = "Proceedings of the Second Workshop for {RE}search on Agent Language Models ({REALM} 2026)",
    month = oct,
    year = "2026",
    address = "Budapest, Hungary",
    publisher = "Association for Computational Linguistics",
    url = "https://aclanthology.org/2026.realm-1.78/",
    html = {https://aclanthology.org/2026.realm-1.78/},
    pdf = {https://aclanthology.org/2026.realm-1.78.pdf},
    pages = "1144--1159",
    ISBN = "979-8-89176-485-9",
abbr          = {LLM Agents},
selected      = {true},
    abstract = "Procedural memory for language agents typically accumulates as trajectories, scripts, or task-specific skills, so memory grows with the number of interactions rather than the number of distinct procedures learned. We propose a workflow-centric procedural memory framework that continually consolidates repeated experience into a bounded set of natural-language workflows. These workflows are merged online under outcome-conditioned update policies. On ALFWorld and ScienceWorld, our memory is competitive with trajectory-level procedural memory on task success while using $3.5\times$ fewer memory tokens on average (1.1-$9.1\times$ across settings), showing that representation besides construction, retrieval and updating is also a key design axis for scalable procedural memory."
}

